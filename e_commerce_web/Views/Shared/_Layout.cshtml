<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - e_commerce_web</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/e_commerce_web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-0 glass-nav">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary brand-logo" asp-area="" asp-controller="Home" asp-action="Index">Lumière</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold" asp-area="" asp-controller="Product" asp-action="Index">Shop</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Support" asp-action="Faq">FAQ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Support" asp-action="ContactUs">Contact Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Support" asp-action="AboutUs">About Us</a>
                        </li>
                    </ul>
                    <form asp-controller="Product" asp-action="Search" method="get" class="d-flex mx-auto me-lg-4 my-2 my-lg-0 search-form-nav d-none d-md-flex">
                        <div class="input-group input-group-sm">
                            <input class="form-control border-end-0 bg-light rounded-start-pill ps-3 shadow-none border-0" type="search" name="query" placeholder="Search products..." aria-label="Search" style="width: 200px;">
                            <button class="btn btn-light bg-light rounded-end-pill pe-3 shadow-none border-0 text-muted" type="submit">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                                  <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                                </svg>
                            </button>
                        </div>
                    </form>
                </div>
                <div class="navbar">
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark fw-bold" asp-controller="Customer" asp-action="Customer">
                                    Hi, @User.Identity.Name
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Login" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link text-dark border-0">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="SignUp" asp-action="Index">Sign Up</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="SignIn" asp-action="Index">Sign In</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 pt-4 pb-4 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="text-dark fw-bold">Lumière</h5>
                    <p class="small">Elevating your lifestyle with premium quality products designed for the modern world.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h5 class="text-dark fw-bold">Support & Info</h5>
                    <ul class="list-unstyled small">
                        <li><a asp-area="" asp-controller="Support" asp-action="Faq" class="text-muted text-decoration-none">FAQ</a></li>
                        <li><a asp-area="" asp-controller="Support" asp-action="ContactUs" class="text-muted text-decoration-none">Contact Us</a></li>
                        <li><a asp-area="" asp-controller="Support" asp-action="AboutUs" class="text-muted text-decoration-none">About Us</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h5 class="text-dark fw-bold">Legal & Policies</h5>
                    <ul class="list-unstyled small">
                        <li><a asp-area="" asp-controller="Support" asp-action="Privacy" class="text-muted text-decoration-none">Privacy Policy</a></li>
                        <li><a asp-area="" asp-controller="Support" asp-action="TermsOfService" class="text-muted text-decoration-none">Terms of Service</a></li>
                        <li><a asp-area="" asp-controller="Support" asp-action="ShippingPolicy" class="text-muted text-decoration-none">Shipping Policy</a></li>
                        <li><a asp-area="" asp-controller="Support" asp-action="ReturnPolicy" class="text-muted text-decoration-none">Return Policy</a></li>
                    </ul>
                </div>
            </div>
            <div class="text-center mt-3 small border-top pt-3">
                &copy; 2026 - Lumière. All rights reserved.
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model e_commerce_web.Models.CustomerViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="full-width" style="background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%); padding: 60px 0 100px 0; margin-top: -16px;">
    <div class="container text-center">
        <h1 class="fw-bold mb-2" style="color: var(--text-main);">Edit Profile</h1>
        <p class="text-muted">Update your personal information</p>
    </div>
</div>

<div class="container" style="margin-top: -40px; margin-bottom: 60px;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card border-0" style="border-radius: var(--border-radius-lg); box-shadow: var(--shadow-lg); overflow: hidden;">
                <div class="card-body p-5">
                    <form asp-controller="Customer" asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="MemberSince" />

                        <!-- Read-only Email display -->
                        <div class="mb-4">
                            <label class="fw-bold text-muted small d-block mb-2 text-uppercase" style="letter-spacing: 0.5px;">Email Address</label>
                            <div class="p-3 bg-light" style="border-radius: var(--border-radius-sm); border: 1px solid rgba(0,0,0,0.05);">
                                <span class="fw-semibold text-muted">@Model.Email</span>
                                <div class="small text-muted mt-1">Email address cannot be changed.</div>
                            </div>
                        </div>

                        <!-- Name Input -->
                        <div class="form-floating mb-4">
                            <input asp-for="Name" class="form-control" placeholder="Full Name" style="border-radius: var(--border-radius-sm);" />
                            <label asp-for="Name" class="text-muted">Full Name</label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- Phone Number Input -->
                        <div class="form-floating mb-4">
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" style="border-radius: var(--border-radius-sm);" />
                            <label asp-for="PhoneNumber" class="text-muted">Phone Number</label>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <!-- Address Textarea -->
                        <div class="form-floating mb-5">
                            <textarea asp-for="Address" class="form-control" placeholder="Shipping Address" style="height: 120px; border-radius: var(--border-radius-sm);"></textarea>
                            <label asp-for="Address" class="text-muted">Shipping Address</label>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="Customer" asp-action="Customer" class="text-muted text-decoration-none fw-semibold">Cancel</a>
                            <button type="submit" class="btn-primary-custom py-3 px-5" style="border-radius: 50px;">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

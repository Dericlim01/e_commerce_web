@model e_commerce_web.Models.CustomerViewModel

@{
    ViewData["Title"] = "Customer";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Customer Profile</h2>
        <div>
            <a asp-controller="Customer" asp-action="Edit" class="btn btn-primary btn-sm me-2">Edit Profile</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Home</a>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white border-bottom-0 pt-4 px-4">
            <h5 class="card-title text-primary fw-bold mb-0">Account Information</h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="fw-bold text-muted small d-block mb-1">Full Name</label>
                    <div class="p-2 bg-light rounded">@Model.Name</div>
                </div>

                <div class="col-md-6">
                    <label class="fw-bold text-muted small d-block mb-1">Email Address</label>
                    <div class="p-2 bg-light rounded">@Model.Email</div>
                </div>

                <div class="col-md-6">
                    <label class="fw-bold text-muted small d-block mb-1">Phone Number</label>
                    <div class="p-2 bg-light rounded">@Model.PhoneNumber</div>
                </div>

                <div class="col-md-6">
                    <label class="fw-bold text-muted small d-block mb-1">Member Since</label>
                    <div class="p-2 bg-light rounded">@Model.MemberSince.ToString("MMM dd, yyyy")</div>
                </div>

                <div class="col-12">
                    <label class="fw-bold text-muted small d-block mb-1">Shipping Address</label>
                    <div class="p-2 bg-light rounded">@Model.Address</div>
                </div>
            </div>
        </div>
    </div>
</div>

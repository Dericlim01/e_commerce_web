@model e_commerce_web.Models.CustomerViewModel

@{
    ViewData["Title"] = "Customer Profile";
}

<div class="full-width" style="background: linear-gradient(135deg, var(--primary-color) 0%, #312e81 100%); padding: 80px 0 120px 0; margin-top: -16px;">
    <div class="container text-center text-white">
        <h1 class="fw-bold mb-2">My Profile</h1>
        <p class="text-white-50">Manage your account settings and preferences</p>
    </div>
</div>

<div class="container" style="margin-top: -60px; margin-bottom: 60px;">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0" style="border-radius: var(--border-radius-lg); box-shadow: var(--shadow-hover); overflow: hidden;">
                <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
                    <h4 class="fw-bold mb-0" style="color: var(--text-main);">Account Information</h4>
                    <div>
                        <a asp-controller="Customer" asp-action="Edit" class="btn-primary-custom py-2 px-4" style="border-radius: 50px; font-size: 0.9rem;">Edit Profile</a>
                    </div>
                </div>
                <div class="card-body p-5">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="fw-bold text-muted small d-block mb-2 text-uppercase" style="letter-spacing: 0.5px;">Full Name</label>
                            <div class="p-3 bg-light" style="border-radius: var(--border-radius-md); border: 1px solid rgba(0,0,0,0.05);">
                                <span class="fw-semibold" style="color: var(--text-main);">@(string.IsNullOrEmpty(Model.Name) ? "Not set" : Model.Name)</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold text-muted small d-block mb-2 text-uppercase" style="letter-spacing: 0.5px;">Email Address</label>
                            <div class="p-3 bg-light" style="border-radius: var(--border-radius-md); border: 1px solid rgba(0,0,0,0.05);">
                                <span class="fw-semibold" style="color: var(--text-main);">@Model.Email</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold text-muted small d-block mb-2 text-uppercase" style="letter-spacing: 0.5px;">Phone Number</label>
                            <div class="p-3 bg-light" style="border-radius: var(--border-radius-md); border: 1px solid rgba(0,0,0,0.05);">
                                <span class="fw-semibold" style="color: var(--text-main);">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not set" : Model.PhoneNumber)</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="fw-bold text-muted small d-block mb-2 text-uppercase" style="letter-spacing: 0.5px;">Member Since</label>
                            <div class="p-3 bg-light" style="border-radius: var(--border-radius-md); border: 1px solid rgba(0,0,0,0.05);">
                                <span class="fw-semibold" style="color: var(--text-main);">@Model.MemberSince.ToString("MMM dd, yyyy")</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="fw-bold text-muted small d-block mb-2 text-uppercase" style="letter-spacing: 0.5px;">Shipping Address</label>
                            <div class="p-3 bg-light" style="border-radius: var(--border-radius-md); border: 1px solid rgba(0,0,0,0.05);">
                                <span class="fw-semibold" style="color: var(--text-main);">@(string.IsNullOrEmpty(Model.Address) ? "Not set" : Model.Address)</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mt-5 text-center">
                        <a asp-controller="Home" asp-action="Index" class="btn-outline-custom py-2 px-4">Back to Shopping</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

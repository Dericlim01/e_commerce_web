@{
    ViewData["Title"] = "About Us";
}

<div class="container my-5">
    <div class="row align-items-center mb-5">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <h1 class="display-4 fw-bold text-dark mb-3">Our Story</h1>
            <p class="lead text-muted mb-4">
                Lumière was born out of a desire to create a more mindful, elevated shopping experience. We believe that everyday essentials should be both beautiful and functional.
            </p>
            <p class="text-muted">
                Since our founding in 2024, we've been dedicated to sourcing the highest quality materials and partnering with artisans who share our commitment to craftsmanship and sustainability. Every product in our collection is thoughtfully curated to bring joy and elegance to your daily life.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="bg-light rounded-4 shadow-sm p-5 text-center" style="min-height: 400px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                <!-- Placeholder for a brand image -->
                <h3 class="text-secondary opacity-50 fw-bold">Elevating the Everyday</h3>
            </div>
        </div>
    </div>

    <div class="row py-5 mt-4 border-top">
        <div class="col-12 text-center mb-5">
            <h2 class="fw-bold">Our Values</h2>
        </div>
        
        <div class="col-md-4 mb-4 text-center">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3 shadow" style="width: 80px; height: 80px;">
                <i class="bi bi-gem fs-2"></i>
            </div>
            <h4 class="fw-bold">Quality First</h4>
            <p class="text-muted px-3">We never compromise on quality. Our products are designed to last, using premium materials and expert craftsmanship.</p>
        </div>
        
        <div class="col-md-4 mb-4 text-center">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3 shadow" style="width: 80px; height: 80px;">
                <i class="bi bi-tree fs-2"></i>
            </div>
            <h4 class="fw-bold">Sustainability</h4>
            <p class="text-muted px-3">We are committed to minimizing our environmental footprint by choosing eco-friendly packaging and ethical sourcing.</p>
        </div>
        
        <div class="col-md-4 mb-4 text-center">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3 shadow" style="width: 80px; height: 80px;">
                <i class="bi bi-heart fs-2"></i>
            </div>
            <h4 class="fw-bold">Customer Love</h4>
            <p class="text-muted px-3">Your satisfaction is our priority. We strive to provide an exceptional shopping experience and dedicated support.</p>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}

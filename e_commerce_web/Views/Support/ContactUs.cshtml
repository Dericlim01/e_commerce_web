@model e_commerce_web.Models.ContactUsViewModel
@{
    ViewData["Title"] = "Contact Us";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h1 class="display-4 fw-bold text-center mb-4">Get in Touch</h1>
            <p class="text-center text-muted mb-5">We'd love to hear from you. Please fill out the form below or use our contact details.</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded shadow-sm" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="row g-5">
                <div class="col-md-7">
                    <div class="card shadow-sm border-0 rounded-4 p-4 glass-card">
                        <h4 class="fw-bold mb-4">Send us a Message</h4>
                        <form asp-action="ContactUs" method="post">
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label text-muted fw-semibold">Your Name</label>
                                <input asp-for="Name" class="form-control rounded-pill px-3 py-2 border-0 bg-light" placeholder="John Doe" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label text-muted fw-semibold">Email Address</label>
                                <input asp-for="Email" type="email" class="form-control rounded-pill px-3 py-2 border-0 bg-light" placeholder="name@example.com" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Subject" class="form-label text-muted fw-semibold">Subject</label>
                                <input asp-for="Subject" class="form-control rounded-pill px-3 py-2 border-0 bg-light" placeholder="How can we help you?" />
                                <span asp-validation-for="Subject" class="text-danger small"></span>
                            </div>
                            <div class="mb-4">
                                <label asp-for="Message" class="form-label text-muted fw-semibold">Message</label>
                                <textarea asp-for="Message" class="form-control rounded-4 px-3 py-2 border-0 bg-light" rows="5" placeholder="Write your message here..."></textarea>
                                <span asp-validation-for="Message" class="text-danger small"></span>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold py-2 shadow">Send Message</button>
                        </form>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="card shadow-sm border-0 rounded-4 p-4 h-100 bg-primary text-white">
                        <h4 class="fw-bold mb-4">Contact Information</h4>
                        <p class="mb-4 opacity-75">Fill up the form and our team will get back to you within 24 hours.</p>
                        
                        <div class="d-flex align-items-center mb-4">
                            <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                <i class="bi bi-telephone-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Phone</h6>
                                <p class="mb-0 opacity-75">+1 (555) 123-4567</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center mb-4">
                            <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                <i class="bi bi-envelope-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Email</h6>
                                <p class="mb-0 opacity-75">support@lumiere.com</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-center">
                            <div class="bg-white text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                <i class="bi bi-geo-alt-fill"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Address</h6>
                                <p class="mb-0 opacity-75">123 Commerce Avenue<br />Suite 100<br />New York, NY 10001</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <!-- Need Bootstrap Icons for this view -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}

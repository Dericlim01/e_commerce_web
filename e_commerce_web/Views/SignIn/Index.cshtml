@model e_commerce_web.Models.SignInViewModel
@{
    ViewData["Title"] = "SignIn";
}

<div class="full-width d-flex align-items-center" style="min-height: calc(100vh - 150px); background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%); margin-top: -16px; padding: 60px 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 col-xl-4">
                <div class="card border-0" style="border-radius: var(--border-radius-lg); box-shadow: var(--shadow-lg); overflow: hidden;">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <h2 class="fw-bold mb-2" style="color: var(--text-main); letter-spacing: -0.5px;">Welcome Back</h2>
                            <p class="text-muted">Please sign in to your account</p>
                        </div>

                        <form asp-controller="SignIn" asp-action="SignIn" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                            <!-- Email Input -->
                            <div class="form-floating mb-4">
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" style="border-radius: var(--border-radius-sm);" />
                                <label asp-for="Email" class="text-muted"></label>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Password Input -->
                            <div class="form-floating mb-4">
                                <input asp-for="Password" class="form-control" placeholder="Password" style="border-radius: var(--border-radius-sm);" />
                                <label asp-for="Password" class="text-muted"></label>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Remember Me & Forgot Password -->
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input asp-for="RememberMe" class="form-check-input" id="rememberMe" style="cursor: pointer;" />
                                    <label asp-for="RememberMe" class="form-check-label text-secondary small" for="rememberMe" style="cursor: pointer;"></label>
                                </div>
                                <a asp-controller="ForgotPassword" asp-action="Index" class="text-primary text-decoration-none small fw-semibold">Forgot password?</a>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn-primary-custom w-100 py-3 mb-3 text-center d-block" style="border-radius: var(--border-radius-sm);">
                                Sign In
                            </button>
                            
                            <div class="text-center mt-4">
                                <p class="text-muted small mb-0">Don't have an account? <a asp-controller="SignUp" asp-action="Index" class="text-primary text-decoration-none fw-semibold">Sign up</a></p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

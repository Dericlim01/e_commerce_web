@{
    ViewData["Title"] = "Access Denied";
}

<div class="container d-flex flex-column align-items-center justify-content-center min-vh-75 py-5 text-center mt-5">
    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mb-4 shadow-sm" style="width: 100px; height: 100px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="#dc3545" class="bi bi-shield-lock-fill" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.777 11.777 0 0 0 2.517 2.453c.386.273.744.482 1.048.625.28.132.581.24.829.24s.548-.108.829-.24a7.159 7.159 0 0 0 1.048-.625 11.775 11.775 0 0 0 2.517-2.453c1.678-2.195 3.061-5.513 2.465-9.99a1.541 1.541 0 0 0-1.044-1.263 62.467 62.467 0 0 0-2.887-.87C9.843.266 8.69 0 8 0zm0 5a1.5 1.5 0 0 1 .5 2.915l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 0 1 8 5z"/>
        </svg>
    </div>
    <h1 class="display-5 fw-bold text-dark mb-3">Access Denied</h1>
    <p class="text-muted fs-5 mb-5 max-w-md mx-auto">
        Oops! It looks like you don't have the required permissions to view this page. If you believe this is a mistake, please contact support.
    </p>
    <div class="d-flex gap-3 justify-content-center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-dark px-4 py-2 rounded-pill fw-medium shadow-sm transition-hover">
            Return Home
        </a>
        <a asp-controller="SignIn" asp-action="Index" class="btn btn-outline-dark px-4 py-2 rounded-pill fw-medium transition-hover">
            Sign In with Different Account
        </a>
    </div>
</div>